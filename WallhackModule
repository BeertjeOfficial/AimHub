local function ApplyDefaults(Target, Defaults)
	for Key in next, Target do
		Target[Key] = nil
	end

	for Key, Value in next, Defaults do
		Target[Key] = Value
	end
end

--// Functions -------------------------------------------------------------

Environment.Functions = {}

function Environment.Functions:Exit()
	for _, Connection in next, ServiceConnections do
		Connection:Disconnect()
	end

	ServiceConnections = {}

	for _, State in next, Environment.WrappedPlayers do
		RemoveState(State)
	end

	Environment.WrappedPlayers = {}

	for _, Part in next, Environment.Crosshair.Parts do
		RemoveDrawing(Part)
	end

	local Hub = getgenv().AirHub

	if Hub then
		Hub.WallHack = nil
	end
end

function Environment.Functions:Restart()
	for _, Connection in next, ServiceConnections do
		Connection:Disconnect()
	end

	ServiceConnections = {}

	for _, State in next, Environment.WrappedPlayers do
		RemoveState(State)
	end

	Environment.WrappedPlayers = {}

	Load()
end

function Environment.Functions:ResetSettings()
	-- Mutate the existing tables in place: the hub stores references to these
	-- tables, so replacing them would silently disconnect the whole UI.
	local CustomTeamCheck = Environment.Settings.CustomTeamCheck

	ApplyDefaults(Environment.Settings, DEFAULT_SETTINGS)
	ApplyDefaults(Environment.Visuals.ChamsSettings, DEFAULT_CHAMS)
	ApplyDefaults(Environment.Visuals.ESPSettings, DEFAULT_ESP)
	ApplyDefaults(Environment.Visuals.TracersSettings, DEFAULT_TRACERS)
	ApplyDefaults(Environment.Visuals.BoxSettings, DEFAULT_BOXES)
	ApplyDefaults(Environment.Visuals.HeadDotSettings, DEFAULT_HEADDOTS)
	ApplyDefaults(Environment.Visuals.HealthBarSettings, DEFAULT_HEALTHBAR)
	ApplyDefaults(Environment.Crosshair.Settings, DEFAULT_CROSSHAIR)

	Environment.Settings.CustomTeamCheck = CustomTeamCheck

	if type(Environment.Settings.IgnoredPlayers) ~= "table" then
		Environment.Settings.IgnoredPlayers = {}
	else
		table.clear(Environment.Settings.IgnoredPlayers)
	end
end

